{
    "compilerOptions": {
        "target": "ESNext",
        "strict": true,
        "moduleResolution": "nodenext",
        "module": "NodeNext",
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true
    },
    "include": ["."],
    "exclude": ["node_modules", "bench", "__test__"]
}
